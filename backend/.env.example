# Kopieren nach backend/.env und ausfüllen. Die .env selbst NIE committen (steht in .gitignore).

# Port des Servers (Standard 3000)
PORT=3000

# Mailversand per SMTP. Leer lassen = Entwicklungsmodus: Anfragen erscheinen nur in der Konsole.
SMTP_HOST=
# 587 = STARTTLS (üblich), 465 = TLS von Anfang an
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Absender (muss zum SMTP-Konto passen) und Empfänger der Anfragen
MAIL_FROM="Website Elektro Berger <website@elektro-berger.example>"
MAIL_TO=info@elektro-berger.example

# Nur auf 1 setzen, wenn der Server hinter einem Reverse Proxy läuft (dann zählt X-Forwarded-For fürs Rate-Limit)
TRUST_PROXY=0
