{{!-- Footer für alle Seiten. Kontext aus vite.config.js: site (Firmendaten), home (Präfix für Anker), current.<seite> (aktuelle Seite) --}}
<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <div class="site-footer__col">
        <h2 class="visually-hidden">Unternehmen</h2>
        <p class="brand brand--on-dark">
          <span class="brand__mark" aria-hidden="true">
            <svg class="icon"><use href="#i-bolt"/></svg>
          </span>
          <span class="brand__text">{{site.brand.prefix}} <strong>{{site.brand.name}}</strong></span>
        </p>
        <p class="site-footer__claim">Ihr {{site.business}} in {{site.address.city}}</p>
        <address class="site-footer__address">
          {{site.name}}<br>
          {{site.address.street}}<br>
          {{site.address.zip}} {{site.address.city}}
        </address>
        <p class="site-footer__muted">Meisterbetrieb · seit {{site.founded}}</p>
      </div>

      <div class="site-footer__col">
        <h2 class="site-footer__title">Kontakt</h2>
        <ul class="site-footer__list">
          <li>Telefon <a href="tel:{{site.phone.tel}}">{{site.phone.display}}</a></li>
          <li class="site-footer__emergency">24/7-Notdienst <a href="tel:{{site.emergency.tel}}">{{site.emergency.display}}</a></li>
          <li><a href="mailto:{{site.email}}">{{site.email}}</a></li>
        </ul>
        <p class="site-footer__muted">{{#each site.hours.week}}{{#unless @first}}<br>{{/unless}}{{dayRange days}} {{time from}}–{{time to}} Uhr{{/each}}</p>
      </div>

      <nav class="site-footer__col" aria-labelledby="footer-seite">
        <h2 class="site-footer__title" id="footer-seite">Seite</h2>
        <ul class="site-footer__list">
          <li><a href="{{home}}#leistungen">Leistungen</a></li>
          <li><a href="{{home}}#referenzen">Referenzen</a></li>
          <li><a href="{{home}}#ueber-uns">Über uns</a></li>
          <li><a href="{{home}}#karriere">Karriere</a></li>
          <li><a href="{{home}}#kontakt">Kontakt</a></li>
          {{#if site.rating.profileUrl}}<li><a href="{{site.rating.profileUrl}}">Bewertungen auf Google</a></li>{{/if}}
        </ul>
      </nav>
    </div>

    <div class="site-footer__bottom">
      <p>&copy; <span data-year>2026</span> {{site.name}}</p>
      <ul class="site-footer__legal">
        <li><a href="impressum.html"{{#if current.impressum}} aria-current="page"{{/if}}>Impressum</a></li>
        <li><a href="datenschutz.html"{{#if current.datenschutz}} aria-current="page"{{/if}}>Datenschutz</a></li>
      </ul>
      <p class="site-footer__note">Fiktiver Betrieb – Übungsprojekt</p>
    </div>
  </div>
</footer>
